# --- PostgreSQL ---
POSTGRES_USER=moveit
POSTGRES_PASSWORD=moveit
POSTGRES_DB=moveit
# Host port for the database container (5433 avoids clashes with a local Postgres)
POSTGRES_HOST_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql+psycopg://moveit:moveit@db:5432/moveit
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
BACKEND_PORT=8000

# Seeded provider account
PROVIDER_EMAIL=provider@moveit.local
PROVIDER_PASSWORD=provider123

# --- Business rules ---
# Operational buffer between two bookings of the same resource
RESOURCE_BUFFER_MINUTES=60
MAX_MOVING_HELPERS=4
# Service area: Trójmiasto + ~30 km
SERVICE_AREA_RADIUS_KM=30

# --- External APIs ---
# Free tier: https://www.geoapify.com/ (geocoding + routing)
# When empty, the backend falls back to a haversine-based distance estimate.
GEOAPIFY_API_KEY=

# --- Frontend ---
FRONTEND_PORT=8080
# Optional absolute API URL for local development without the Vite proxy
# VITE_API_URL=http://localhost:8000/api/v1
