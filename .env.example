# --- PostgreSQL ---
POSTGRES_USER=janusztrans
POSTGRES_PASSWORD=janusztrans
POSTGRES_DB=janusztrans
# Host port for the database container (5433 avoids clashes with a local Postgres)
POSTGRES_HOST_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql+psycopg://janusztrans:janusztrans@db:5432/janusztrans
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
BACKEND_PORT=8000

# Seeded provider account
PROVIDER_EMAIL=provider@janusztrans.local
PROVIDER_PASSWORD=provider123

# --- Business rules ---
# Operational buffer between two bookings of the same resource
RESOURCE_BUFFER_MINUTES=60
MAX_MOVING_HELPERS=4
# Service area: Trójmiasto + ~30 km around the configured center (Sopot pier)
SERVICE_AREA_RADIUS_KM=30
SERVICE_AREA_CENTER_LATITUDE=54.4416
SERVICE_AREA_CENTER_LONGITUDE=18.5601

# --- Security ---
# Lockbox codes are encrypted with AES-256-GCM. Use a long random value and
# keep it stable: changing it makes existing codes unreadable.
HANDOVER_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- External APIs ---
# Free tier: https://www.geoapify.com/ (geocoding + routing)
# When empty, location search/reverse return 503 and pricing falls back to haversine.
GEOAPIFY_API_KEY=

# Free tier: https://console.groq.com/keys (AI move assistant in the booking wizard).
# When empty, the assistant is hidden and the rest of the app works unchanged.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Frontend ---
FRONTEND_PORT=8080
# Optional absolute API URL for local development without the Vite proxy
# VITE_API_URL=http://localhost:8000/api/v1
